# Copy this file to .env and adjust it to your needs: cp env.example .env
# All options are described in configuration.md.

# --- General ---------------------------------------------------------------

# hcloud API token with Read & Write permissions. Handle with care!
HCLOUD_TOKEN=yourSecretHcloudToken

# IPv4, IPv6 or Dual
IP_MODE=Dual

# Timeout in seconds for HTTP requests (IP API and hcloud API)
HTTP_TIMEOUT=30

# ERROR, INFO or DEBUG
LOGLEVEL=INFO

TZ=Europe/Berlin

# --- Trigger ---------------------------------------------------------------

# interval (default) or updateUrl
TRIGGER=interval

# Seconds between IP checks, only used with TRIGGER=interval
UPDATE_INTERVAL=300

# --- IP address source -----------------------------------------------------

# apiUrl (default) or updateUrl (requires TRIGGER=updateUrl)
IP_ADDRESS_SRC=apiUrl

# Custom IP API endpoints, only used with IP_ADDRESS_SRC=apiUrl.
# Defaults: https://api.ipify.org and https://api6.ipify.org
#IPv4_API_URL=https://api.example/ipv4
#IPv6_API_URL=https://api.example/ipv6

# --- DDNS update URL (TRIGGER=updateUrl) -----------------------------------

# Credentials expected in the user and pass parameters of the update URL
#UPDATE_URL_USER=ddns
#UPDATE_URL_PASS=yourSecretPassword

# <ip>:<port> or :<port>, default :8080 (all interfaces). Prefer your LAN address.
#UPDATE_URL_LISTEN=192.168.0.123:8080

# --- IPv6 from prefix (IP_ADDRESS_SRC=updateUrl) ---------------------------

# Lower 64 bits of the host's IPv6 address, required with IP_MODE=IPv6 or Dual
#IPv6_INTERFACE_ID=66ec:face:7324:81ea

# Optional: overrides the length of the prefix parameter (1-64)
#IPv6_PREFIX_LENGTH=56

# Optional: subnet ID (hex) between prefix length and /64
#IPv6_PREFIX_ID=bc
